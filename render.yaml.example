services:
  # Backend Service
  - type: web
    name: codesys-backend
    env: java
    region: frankfurt
    plan: free
    buildCommand: cd backend && mvn clean package -DskipTests
    startCommand: java -jar backend/target/codesys-backend-0.0.2-SNAPSHOT.jar
    envVars:
      - key: SPRING_PROFILES_ACTIVE
        value: production
      - key: SERVER_URL
        fromService:
          type: web
          name: codesys-backend
          property: host
      - key: OPENAI_API_KEY
        sync: false  # Set this in Render dashboard
      - key: FHIR_SERVER_URL
        fromService:
          type: web
          name: snowstorm-lite
          property: host
        # This will be set automatically to: https://snowstorm-lite.onrender.com/fhir
      - key: JAVA_VERSION
        value: 17

  # Frontend Service (Static Site)
  - type: web
    name: codesys-frontend
    env: static
    region: frankfurt
    plan: free
    buildCommand: cd frontend && npm install && npm run build
    staticPublishPath: frontend/dist
    envVars:
      - key: VITE_API_URL
        fromService:
          type: web
          name: codesys-backend
          property: host
      - key: NODE_VERSION
        value: 18

  # Snowstorm Lite Service
  - type: web
    name: snowstorm-lite
    env: docker
    region: frankfurt
    plan: free  # May need 'starter' plan for better performance
    dockerfilePath: ./snowstorm-lite/Dockerfile
    dockerContext: ./snowstorm-lite
    healthCheckPath: /health
    envVars:
      - key: SPRING_PROFILES_ACTIVE
        value: production
      - key: SERVER_PORT
        value: 8080
      # Snowstorm Lite uses embedded Elasticsearch, no additional config needed

